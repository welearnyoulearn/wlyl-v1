            "required": true,
            "schema": { "type": "string" },
            "example": "2026-05-25"
          }
        ],
        "responses": {
          "200": {
            "description": "Absentees & Latecomers list retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "date": { "type": "string", "example": "2026-05-25" },
                    "absent_count": { "type": "integer", "example": 1 },
                    "late_count": { "type": "integer", "example": 0 },
                    "absent": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "card_id": { "type": "string", "example": "1001001004" },
                          "name": { "type": "string", "example": "Suresh Goud" },
                          "department": { "type": "string", "example": "Support" }
                        }
                      }
                    },
                    "late": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "card_id": { "type": "string", "example": "1001001006" },
                          "name": { "type": "string", "example": "Kalyani Sen" },
                          "scan_time": { "type": "string", "example": "09:07:00" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
